# API
PORT=3001
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=invintel
# Set to false to stop new sign-ups (the very first account can always register)
ALLOW_REGISTRATION=true
# Set to true when serving over HTTPS so the session cookie is Secure
COOKIE_SECURE=false
# Encrypts webhook signing secrets at rest (AES-256-GCM). Keep this off the database host. Without it they are stored as they are.
WEBHOOK_SECRET_KEY=
