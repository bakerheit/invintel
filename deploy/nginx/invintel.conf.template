# Invintel behind nginx: serves the built web app and passes /api to the API on loopback.
# Rendered by run-local.sh (it fills in @WEB_ROOT@, @API_PORT@, @LISTEN@ and @PREFIX@). Not for the public internet as it stands:
# it speaks plain HTTP and has no TLS. Put TLS in front of it (a tunnel, or certificates) before anyone outside your network uses it.
worker_processes 1;
pid @PREFIX@/nginx.pid;
error_log @PREFIX@/error.log warn;
events { worker_connections 256; }

http {
  include /opt/homebrew/etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log @PREFIX@/access.log;
  sendfile on;
  server_tokens off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Sign-in and sign-up get a tighter limit than the rest of the API (the app also rate-limits failed logins).
  limit_req_zone $binary_remote_addr zone=auth:2m rate=10r/m;
  limit_req_zone $binary_remote_addr zone=api:5m rate=20r/s;

  # Behind a tunnel or proxy on this machine every request comes from 127.0.0.1. Take the visitor's real address from the
  # header the tunnel sets, but only when the connection itself is from loopback, so a LAN client can't fake it.
  set_real_ip_from 127.0.0.1;
  real_ip_header CF-Connecting-IP;

  upstream invintel_api { server 127.0.0.1:@API_PORT@; keepalive 16; }

  server {
    listen @LISTEN@;
    client_max_body_size 4m;
    @AUTH@
    root @WEB_ROOT@;
    index index.html;

    location /api/auth/ {
      include @PREFIX@/security.conf;
      limit_req zone=auth burst=10 nodelay;
      proxy_pass http://invintel_api;
      include @PREFIX@/proxy.conf;
    }
    location /api/ {
      include @PREFIX@/security.conf;
      limit_req zone=api burst=40 nodelay;
      proxy_pass http://invintel_api;
      include @PREFIX@/proxy.conf;
    }

    # Built assets have hashed names, so they can be cached for a long time. index.html must always be fresh.
    # add_header in a location replaces the ones from the server block, so every location includes the security headers itself.
    location /assets/ { include @PREFIX@/security.conf; expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location / { include @PREFIX@/security.conf; add_header Cache-Control "no-store"; try_files $uri /index.html; }
  }
}
